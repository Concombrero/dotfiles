#!/usr/bin/env sh
set -eu

sessions=$(tmux list-sessions -F '#S' 2>/dev/null || true)
[ "$sessions" = "0" ] || exit 0

"$HOME/.config/tmux/repair-resurrect-last"

last=$(readlink "$HOME/.tmux/resurrect/last" 2>/dev/null || true)
[ -n "$last" ] || exit 0
[ -s "$HOME/.tmux/resurrect/$last" ] || exit 0

restore_script="$HOME/.tmux/plugins/tmux-resurrect/scripts/restore.sh"
[ -x "$restore_script" ] || exit 0

TMUX="$(tmux display-message -p '#{socket_path},#{pid},0')" "$restore_script" >/dev/null 2>&1 || true
