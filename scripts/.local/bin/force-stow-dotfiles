#!/usr/bin/env bash

set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

DRY_RUN=false
REPO_DIR=""
BACKUP_DIR=""

declare -A MOVED_TARGETS=()
declare -a STOW_FAILED=()

log() {
    printf '%b[OK]%b %s\n' "$GREEN" "$NC" "$1"
}

info() {
    printf '%b[INFO]%b %s\n' "$BLUE" "$NC" "$1"
}

warn() {
    printf '%b[WARN]%b %s\n' "$YELLOW" "$NC" "$1"
}

error() {
    printf '%b[ERROR]%b %s\n' "$RED" "$NC" "$1" >&2
}

die() {
    error "$1"
    exit 1
}

usage() {
    cat <<'EOF'
Usage: force-stow-dotfiles [OPTIONS] [PACKAGE...]

Back up conflicting target files in $HOME, then restow the selected packages.
If no package names are given, all packages from packages/stow_list.txt are used.

Options:
  --repo-dir PATH     Dotfiles repo root (default: $DOTFILES_DIR, $PWD, or ~/dotfiles)
  --backup-dir PATH   Backup destination (default: ~/dotfiles-force-stow-backup-<timestamp>)
  -n, --dry-run       Show what would be moved and stowed without changing anything
  -h, --help          Show this help text
EOF
}

resolve_repo_dir() {
    if [ -n "${DOTFILES_DIR:-}" ] && [ -f "$DOTFILES_DIR/packages/stow_list.txt" ]; then
        printf '%s\n' "$DOTFILES_DIR"
        return 0
    fi

    if [ -f "$PWD/packages/stow_list.txt" ]; then
        printf '%s\n' "$PWD"
        return 0
    fi

    if [ -f "$HOME/dotfiles/packages/stow_list.txt" ]; then
        printf '%s\n' "$HOME/dotfiles"
        return 0
    fi

    return 1
}

unique_backup_path() {
    local dest=$1
    local candidate=$dest
    local suffix=1

    while [ -e "$candidate" ] || [ -L "$candidate" ]; do
        candidate="${dest}.bak${suffix}"
        suffix=$((suffix + 1))
    done

    printf '%s\n' "$candidate"
}

backup_target() {
    local target=$1
    local rel dest

    if [ -n "${MOVED_TARGETS[$target]+x}" ]; then
        return 0
    fi

    rel=${target#"$HOME"/}
    dest="$BACKUP_DIR/$rel"
    dest=$(unique_backup_path "$dest") || return 1

    if [ "$DRY_RUN" = true ]; then
        info "[dry-run] Back up $target -> $dest"
        MOVED_TARGETS["$target"]=$dest
        return 0
    fi

    mkdir -p "$(dirname "$dest")" || return 1
    mv "$target" "$dest" || return 1
    MOVED_TARGETS["$target"]=$dest
    info "Backed up $target -> $dest"
}

ensure_parent_directories() {
    local target=$1
    local parent current rel part
    local -a parts

    parent=$(dirname "$target")
    if [ "$parent" = "$HOME" ]; then
        return 0
    fi

    rel=${parent#"$HOME"/}
    current="$HOME"

    IFS='/' read -r -a parts <<<"$rel"
    for part in "${parts[@]}"; do
        current="$current/$part"

        if [ -e "$current" ] || [ -L "$current" ]; then
            if [ ! -d "$current" ]; then
                backup_target "$current" || return 1
            fi
        fi
    done
}

prepare_target_for_source() {
    local source=$1
    local package_dir=$2
    local rel target source_real target_real

    rel=${source#"$package_dir"/}
    target="$HOME/$rel"

    ensure_parent_directories "$target" || return 1

    if [ -L "$target" ]; then
        source_real=$(readlink -f "$source" 2>/dev/null || printf '%s\n' "$source")
        target_real=$(readlink -f "$target" 2>/dev/null || printf '%s\n' "$target")

        if [ "$source_real" = "$target_real" ]; then
            return 0
        fi

        backup_target "$target" || return 1
        return 0
    fi

    if [ -e "$target" ]; then
        backup_target "$target" || return 1
    fi
}

prepare_package_targets() {
    local package=$1
    local package_dir="$REPO_DIR/$package"
    local source

    if [ ! -d "$package_dir" ]; then
        warn "Package directory not found, skipping: $package_dir"
        return 0
    fi

    info "Preparing targets for package: $package"

    while IFS= read -r -d '' source; do
        prepare_target_for_source "$source" "$package_dir" || return 1
    done < <(find "$package_dir" -mindepth 1 \( -type f -o -type l \) ! -name 'AGENTS.md' -print0)
}

stow_package() {
    local package=$1
    local cmd=(stow -R -d "$REPO_DIR" -t "$HOME" --no-folding --ignore='^AGENTS\.md$' "$package")

    if [ "$DRY_RUN" = true ]; then
        cmd=(stow -n -R -v -d "$REPO_DIR" -t "$HOME" --no-folding --ignore='^AGENTS\.md$' "$package")
        info "[dry-run] Restowing package: $package"
    else
        cmd=(stow -R -v -d "$REPO_DIR" -t "$HOME" --no-folding --ignore='^AGENTS\.md$' "$package")
        info "Restowing package: $package"
    fi

    if ! "${cmd[@]}"; then
        STOW_FAILED+=("$package")
        warn "Failed to stow package: $package"
        return 1
    fi

    return 0
}

load_packages() {
    local stow_list="$REPO_DIR/packages/stow_list.txt"
    local -n packages_ref=$1

    if [ "$#" -gt 1 ]; then
        return 0
    fi

    if [ ! -f "$stow_list" ]; then
        die "Missing stow list: $stow_list"
    fi

    mapfile -t packages_ref < <(grep -vE '^\s*#|^\s*$' "$stow_list")
}

main() {
    local timestamp
    local -a packages=()
    local arg

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --repo-dir)
                [ "$#" -ge 2 ] || die "--repo-dir requires a path"
                REPO_DIR=$2
                shift 2
                ;;
            --backup-dir)
                [ "$#" -ge 2 ] || die "--backup-dir requires a path"
                BACKUP_DIR=$2
                shift 2
                ;;
            -n|--dry-run)
                DRY_RUN=true
                shift
                ;;
            -h|--help)
                usage
                exit 0
                ;;
            *)
                packages+=("$1")
                shift
                ;;
        esac
    done

    if ! command -v stow >/dev/null 2>&1; then
        die "GNU Stow is required but was not found in PATH"
    fi

    if [ -z "$REPO_DIR" ]; then
        REPO_DIR=$(resolve_repo_dir) || die "Could not locate the dotfiles repo. Run from the repo root or pass --repo-dir"
    fi

    if [ ! -d "$REPO_DIR" ]; then
        die "Repo directory does not exist: $REPO_DIR"
    fi

    if [ ${#packages[@]} -eq 0 ]; then
        load_packages packages
    fi

    timestamp=$(date +%F-%H%M%S)
    if [ -z "$BACKUP_DIR" ]; then
        BACKUP_DIR="$HOME/dotfiles-force-stow-backup-$timestamp"
    fi

    if [ "$DRY_RUN" = true ]; then
        info "Dry run mode enabled. No files will be moved."
    else
        mkdir -p "$BACKUP_DIR" || die "Could not create backup directory: $BACKUP_DIR"
    fi

    info "Repo directory: $REPO_DIR"
    info "Backup directory: $BACKUP_DIR"

    for arg in "${packages[@]}"; do
        prepare_package_targets "$arg" || warn "Could not fully prepare targets for package: $arg"
    done

    for arg in "${packages[@]}"; do
        stow_package "$arg" || true
    done

    if [ ${#STOW_FAILED[@]} -gt 0 ]; then
        warn "Some packages still failed to stow: ${STOW_FAILED[*]}"
        exit 1
    fi

    log "Selected packages were restowed successfully."
}

main "$@"
