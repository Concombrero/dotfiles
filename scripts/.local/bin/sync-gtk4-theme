#!/usr/bin/env bash

set -u

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

log() { printf '%b[OK]%b %s\n' "$GREEN" "$NC" "$1"; }
info() { printf '%b[INFO]%b %s\n' "$BLUE" "$NC" "$1"; }
warn() { printf '%b[WARN]%b %s\n' "$YELLOW" "$NC" "$1"; }
error() { printf '%b[ERROR]%b %s\n' "$RED" "$NC" "$1" >&2; }

resolve_theme_name() {
    local settings_file=${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/settings.ini
    local theme_name=${GTK_THEME_NAME:-}

    if [ -n "$theme_name" ]; then
        printf '%s\n' "$theme_name"
        return 0
    fi

    if [ -f "$settings_file" ]; then
        theme_name=$(awk -F= '/^gtk-theme-name=/{print $2; exit}' "$settings_file")
    fi

    if [ -n "$theme_name" ]; then
        printf '%s\n' "$theme_name"
        return 0
    fi

    printf '%s\n' 'SolArc'
}

find_theme_dir() {
    local theme_name=$1
    local candidate

    for candidate in \
        "$HOME/.local/share/themes/$theme_name" \
        "$HOME/.themes/$theme_name" \
        "/usr/local/share/themes/$theme_name" \
        "/usr/share/themes/$theme_name"
    do
        [ -d "$candidate/gtk-4.0" ] && printf '%s\n' "$candidate" && return 0
    done

    return 1
}

sync_gtk4_assets() {
    local theme_name=$1
    local theme_dir=$2
    local source_dir="$theme_dir/gtk-4.0"
    local target_dir=${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0
    local css_file

    if ! mkdir -p "$target_dir"; then
        error "Failed to create $target_dir."
        return 1
    fi

    for css_file in gtk.css gtk-dark.css; do
        if [ ! -f "$source_dir/$css_file" ]; then
            error "Theme $theme_name is missing $source_dir/$css_file."
            return 1
        fi

        if ! cp -f "$source_dir/$css_file" "$target_dir/$css_file"; then
            error "Failed to copy $css_file into $target_dir."
            return 1
        fi
    done

    if [ ! -d "$source_dir/assets" ]; then
        error "Theme $theme_name is missing $source_dir/assets."
        return 1
    fi

    rm -rf "$target_dir/assets"
    if ! cp -a "$source_dir/assets" "$target_dir/assets"; then
        error "Failed to copy GTK4 theme assets into $target_dir/assets."
        return 1
    fi

    log "Synced GTK4/libadwaita theme assets from $theme_dir."
}

has_local_gtk4_assets() {
    local target_dir=${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0

    [ -f "$target_dir/gtk.css" ] && [ -f "$target_dir/gtk-dark.css" ]
}

configure_flatpak_overrides() {
    if ! command -v flatpak >/dev/null 2>&1; then
        info "flatpak not found; skipping Flatpak theme overrides."
        return 0
    fi

    if ! flatpak override --user \
        --filesystem=xdg-config/gtk-3.0:ro \
        --filesystem=xdg-config/gtk-4.0:ro \
        --filesystem=xdg-data/icons:ro \
        --filesystem=xdg-data/themes:ro \
        --filesystem=~/.icons:ro \
        --filesystem=~/.themes:ro
    then
        error "Failed to configure global Flatpak GTK theme overrides."
        return 1
    fi

    log "Configured global Flatpak access to GTK settings, themes, and icons."
}

main() {
    local theme_name theme_dir

    theme_name=$(resolve_theme_name)
    if theme_dir=$(find_theme_dir "$theme_name"); then
        sync_gtk4_assets "$theme_name" "$theme_dir" || return 1
    elif has_local_gtk4_assets; then
        info "Using tracked GTK4/libadwaita overrides in ${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0."
    else
        error "Could not find the GTK theme '$theme_name' in standard theme directories, and no tracked GTK4 fallback exists."
        return 1
    fi

    configure_flatpak_overrides || return 1
}

main "$@"
