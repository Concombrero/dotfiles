# Files in the dotfiles root that should NOT be stowed
# (Stow would try to symlink these into $HOME otherwise)
\.git
\.gitignore
\.stow-local-ignore
install\.sh
install\.log
README\.md
LICENSE

# opencode runtime files that should remain machine-local
^\.config/opencode/package\.json$
^\.config/opencode/bun\.lock$

# nvim plugin lockfile should remain machine-local
^\.config/nvim/lazy-lock\.json$
