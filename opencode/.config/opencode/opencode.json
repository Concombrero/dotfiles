{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "firecrawl": {
      "type": "local",
      "command": ["npx", "-y", "firecrawl-mcp"],
      "enabled": true,
      "environment": {
        "FIRECRAWL_API_KEY": "{file:~/.config/opencode/firecrawl_api_key}"
      }
    }
  },
 "permission": {
    "edits": "ask"
  }
}
